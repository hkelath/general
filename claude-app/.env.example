# Anthropic Claude API Key
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Common Room API Key (optional — enables live org signal enrichment)
# Get yours at https://app.commonroom.io/settings/api-keys
COMMON_ROOM_API_KEY=your_common_room_api_key_here

# Server port (default: 3000)
PORT=3000
